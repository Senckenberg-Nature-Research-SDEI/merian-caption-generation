@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix : <http://example.org/ontology#>.

### Classes ###
:Plant a owl:Class.
:Insect a owl:Class.
:BotanicalIllustration a owl:Class.
:Ontology a owl:Class.
:Data a owl:Class.
:Relationships a owl:Class.
:Illustrations a owl:Class.
:Image a owl:Class.
:Project a owl:Class.
:Species a owl:Class.
:SubjectMatterExpert a owl:Class.
:Botanist a owl:Class.
:Entomologist a owl:Class.
:AmbiguousConcepts a owl:Class.
:OverlappingConcepts a owl:Class.
:Research a owl:Class.
:Discovery a owl:Class.
:FieldOfBotany a owl:Class.
:FieldOfEntomology a owl:Class.
:PlantSpecies a owl:Class.
:InsectSpecies a owl:Class.
:Interactions a owl:Class.
:UserFriendlyInterface a owl:Class.
:BotanicalOntology a owl:Class.
:ComplexIllustrations a owl:Class.
:ScientificData a owl:Class.

### Object Properties ###
:has_design a owl:ObjectProperty.
:has_navigation_features a owl:ObjectProperty.
:has_accessibility_options a owl:ObjectProperty.
:has_taxonomy_hierarchy a owl:ObjectProperty.
:has_species_information a owl:ObjectProperty.
:has_image_data a owl:ObjectProperty.
:has_detailed_labels a owl:ObjectProperty.
:has_zoom_functionality a owl:ObjectProperty.
:has_interactive_features a owl:ObjectProperty.
:has_metadata a owl:ObjectProperty.
:has_references a owl:ObjectProperty.
:has_data_visualization a owl:ObjectProperty.

### Datatype Properties ###
:DevelopmentExperience a owl:DatatypeProperty;
    rdfs:domain :Ontology;
    rdfs:range xsd:string.
:BotanicalStudiesFocus a owl:DatatypeProperty;
    rdfs:domain :Ontology;
    rdfs:range xsd:string.
:PlantsAndInsectsFocus a owl:DatatypeProperty;
    rdfs:domain :Ontology;
    rdfs:range xsd:string.
:ScientificName a owl:DatatypeProperty;
    rdfs:domain :Plant, :Insect, :PlantSpecies, :InsectSpecies;
    rdfs:range xsd:string.
:CommonName a owl:DatatypeProperty;
    rdfs:domain :Plant, :Insect, :PlantSpecies, :InsectSpecies;
    rdfs:range xsd:string.
:Family a owl:DatatypeProperty;
    rdfs:domain :Plant, :Insect, :PlantSpecies, :InsectSpecies;
    rdfs:range xsd:string.
:Genus a owl:DatatypeProperty;
    rdfs:domain :Plant, :Insect, :PlantSpecies, :InsectSpecies;
    rdfs:range xsd:string.
:Species a owl:DatatypeProperty;
    rdfs:domain :Plant, :Insect, :PlantSpecies, :InsectSpecies;
    rdfs:range xsd:string.
:Description a owl:DatatypeProperty;
    rdfs:domain :Plant, :Insect, :BotanicalIllustration, :PlantSpecies, :InsectSpecies;
    rdfs:range xsd:string.
:Habitat a owl:DatatypeProperty;
    rdfs:domain :Plant, :Insect, :PlantSpecies, :InsectSpecies;
    rdfs:range xsd:string.
:Uses a owl:DatatypeProperty;
    rdfs:domain :Plant, :PlantSpecies;
    rdfs:range xsd:string.
:Diet a owl:DatatypeProperty;
    rdfs:domain :Insect, :InsectSpecies;
    rdfs:range xsd:string.
:Image a owl:DatatypeProperty;
    rdfs:domain :BotanicalIllustration;
    rdfs:range xsd:string.
:Integration a owl:DatatypeProperty;
    rdfs:domain :Ontology;
    rdfs:range xsd:boolean.
:ProjectName a owl:DatatypeProperty;
    rdfs:domain :Project;
    rdfs:range xsd:string.
:DataAccuracy a owl:DatatypeProperty;
    rdfs:domain :Data;
    rdfs:range xsd:string.
:DataConsistency a owl:DatatypeProperty;
    rdfs:domain :Data, :Relationships;
    rdfs:range xsd:string.
:IllustrationDetail a owl:DatatypeProperty;
    rdfs:domain :Illustrations;
    rdfs:range xsd:string.
:Expertise a owl:DatatypeProperty;
    rdfs:domain :SubjectMatterExpert;
    rdfs:range xsd:string.
:Specialization a owl:DatatypeProperty;
    rdfs:domain :Botanist, :Entomologist;
    rdfs:range xsd:string.
:AccurateReflection a owl:DatatypeProperty;
    rdfs:domain :Ontology;
    rdfs:range xsd:boolean.
:ScientificKnowledge a owl:DatatypeProperty;
    rdfs:domain :Ontology;
    rdfs:range xsd:string.
:Classifications a owl:DatatypeProperty;
    rdfs:domain :Ontology;
    rdfs:range xsd:string.
:Title a owl:DatatypeProperty;
    rdfs:domain :Research;
    rdfs:range xsd:string.
:Authors a owl:DatatypeProperty;
    rdfs:domain :Research;
    rdfs:range xsd:string.
:PublicationDate a owl:DatatypeProperty;
    rdfs:domain :Research;
    rdfs:range xsd:date.
:Keywords a owl:DatatypeProperty;
    rdfs:domain :Research;
    rdfs:range xsd:string.
:ReferenceToResearchEntity a owl:DatatypeProperty;
    rdfs:domain :Discovery;
    rdfs:range :Research.
:Name a owl:DatatypeProperty;
    rdfs:domain :FieldOfBotany, :FieldOfEntomology, :Ontology, :PlantSpecies, :InsectSpecies;
    rdfs:range xsd:string.
:RelatedFields a owl:DatatypeProperty;
    rdfs:domain :Ontology;
    rdfs:range :FieldOfBotany, :FieldOfEntomology.
:TypeOfInteraction a owl:DatatypeProperty;
    rdfs:domain :Interactions;
    rdfs:range xsd:string.
:PlantSpeciesInvolved a owl:DatatypeProperty;
    rdfs:domain :Interactions;
    rdfs:range xsd:string.
:InsectSpeciesInvolved a owl:DatatypeProperty;
    rdfs:domain :Interactions;
    rdfs:range xsd:string.
:DescriptionOfInteraction a owl:DatatypeProperty;
    rdfs:domain :Interactions;
    rdfs:range xsd:string.

### Individuals ###
:Ontology a :Ontology;
    :DevelopmentExperience "String";
    :BotanicalStudiesFocus "String";
    :PlantsAndInsectsFocus "String";
    :Integration true;
    :Project "String";
    :AccurateReflection true;
    :ScientificKnowledge "String";
    :Classifications "String".
:Plant a :Plant.
:Insect a :Insect.
:BotanicalIllustration a :BotanicalIllustration.
:Data a :Data.
:Relationships a :Relationships.
:Illustrations a :Illustrations.
:Image a :Image.
:Project a :Project.
:Species a :Species.
:SubjectMatterExpert a :SubjectMatterExpert.
:Botanist a :Botanist.
:Entomologist a :Entomologist.
:AmbiguousConcepts a :AmbiguousConcepts.
:OverlappingConcepts a :OverlappingConcepts.
:Research a :Research.
:Discovery a :Discovery.
:FieldOfBotany a :FieldOfBotany.
:FieldOfEntomology a :FieldOfEntomology.
:PlantSpecies a :PlantSpecies.
:InsectSpecies a :InsectSpecies.
:Interactions a :Interactions.
:UserFriendlyInterface a :UserFriendlyInterface.
:BotanicalOntology a :BotanicalOntology.
:ComplexIllustrations a :ComplexIllustrations.
:ScientificData a :ScientificData.

### Property Assertions ###
:Plant :ScientificName "String";
    :CommonName "String";
    :Family "String";
    :Genus "String";
    :Species "String";
    :Description "String";
    :Habitat "String";
    :Uses "String".
:Insect :ScientificName "String";
    :CommonName "String";
    :Family "String";
    :Genus "String";
    :Species "String";
    :Description "String";
    :Habitat "String";
    :Diet "String".
:BotanicalIllustration :Image "String";
    :Description "String";
    :BotanicalSpecies "String".
:Data :Accuracy "String";
    :Consistency "String".
:Relationships :Accuracy "String";
    :Consistency "String".
:Illustrations :Detail "String".
:Project :Name "String";
    :Description "String".
:Species :Name "String";
    :Type "String".
:SubjectMatterExpert :Name "String";
    :Expertise "String".
:Botanist :Name "String";
    :Specialization "String".
:Entomologist :Name "String";
    :Specialization "String".
:Research :Title "String";
    :Authors "String";
    :PublicationDate "Date";
    :Keywords "Array of Strings".
:Discovery :Description "String";
    :Research :ReferenceToResearchEntity.
:FieldOfBotany :Name "String";
    :Description "String".
:FieldOfEntomology :Name "String";
    :Description "String".
:PlantSpecies :ScientificName "String";
    :CommonName "String";
    :Family "String";
    :Genus "String";
    :Habitat "String";
    :Uses "String".
:InsectSpecies :ScientificName "String";
    :CommonName "String";
    :Family "String";
    :Genus "String";
    :Habitat "String";
    :Diet "String".
:Interactions :TypeOfInteraction "String";
    :PlantSpeciesInvolved "String";
    :InsectSpeciesInvolved "String";
    :DescriptionOfInteraction "String".
:UserFriendlyInterface :has_design "";
    :has_navigation_features "";
    :has_accessibility_options "".
:BotanicalOntology :has_taxonomy_hierarchy "";
    :has_species_information "";
    :has_image_data "".
:ComplexIllustrations :has_detailed_labels "";
    :has_zoom_functionality "";
    :has_interactive_features "".
:ScientificData :has_metadata "";
    :has_references "";
    :has_data_visualization "".
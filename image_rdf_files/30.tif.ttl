:hasEffectiveness a owl:ObjectProperty.
:hasMethodology a owl:ObjectProperty.
:hasAccuracyAssessment a owl:ObjectProperty.
:hasEffectivenessAssessment a owl:ObjectProperty.
:hasDevelopmentMethodologies a owl:ObjectProperty.
:hasTools a owl:ObjectProperty.
:hasAlignment a owl:ObjectProperty.

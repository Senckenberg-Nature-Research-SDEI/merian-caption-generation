# Individuals
:Flower1 a :Flower;
    :hasColor "string";
    :hasType "string";
    :hasSize "string";
    :hasFragrance "string";
    :hasPetalArrangement "string";
    :hasPetals 0.

:Butterfly1 a :Butterfly;
    :hasColor "string";
    :hasType "string";
    :hasWingspan 0;
    :hasSpecies "string";
    :hasFlightPattern "string";
    :hasFeedingHabits "string".

:Image1 a :Image;
    :hasFlower "string";
    :hasButterfly "string";
    :hasOldBook "string";
    :hasContent "string";
    :hasFormat "string";
    :hasResolution "string".

:Book1 a :Book;
    :hasTitle "string";
    :hasAuthor "string";
    :hasPublicationYear "string".

:Ontology1 a :Ontology;
    :hasAccuracy "string";
    :hasEffectiveness "string";
    :hasDevelopmentMethodologies "string";
    :hasTools "string".

:Validation1 a :Validation;
    :hasMethodology "string";
    :hasAccuracyAssessment "string";
    :hasEffectivenessAssessment "string".

:OntologyDevelopmentProject1 a :OntologyDevelopmentProject;
    :hasProjectName "string";
    :hasProjectDescription "string";
    :hasApproach "string";
    :hasChallengesFaced "string";
    :hasLessonsLearned "string".

:DomainExpert1 a :DomainExpert;
    :hasName "string";
    :hasExpertise "string";
    :hasContactInformation "string".